# Perulangan (Loop)
# ------------------

# For loop dengan range
tulis "Menghitung 1-5:"
untuk i dalam range(1, 6) lakukan
    tulis "Angka:", i
selesai

# For loop dengan list
buat buah = ["apel", "pisang", "jeruk"]
tulis "Daftar buah:"
untuk item dalam buah lakukan
    tulis "-", item
selesai

# While loop
buat counter = 1
selama counter <= 3 lakukan
    tulis "Perulangan ke-", counter
    counter = counter + 1
selesai
