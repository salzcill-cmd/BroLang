# Percabangan (Conditional)
# --------------------------

buat nilai = 85

jika nilai >= 90 maka
    tulis "Grade A"
lainnya jika nilai >= 80 maka
    tulis "Grade B"
lainnya jika nilai >= 70 maka
    tulis "Grade C"
lainnya
    tulis "Grade D"
selesai

# Contoh dengan boolean
buat hujan = benar

jika hujan maka
    tulis "Bawa payung!"
lainnya
    tulis "Cuaca cerah!"
selesai
